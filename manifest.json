{
  "manifest_version": 3,
  "name": "ChatGPT Rerun",
  "version": "0.1.0",
  "description": "Continue a ChatGPT workflow when a GitHub control file says to proceed.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://api.github.com/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "ChatGPT Rerun",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
