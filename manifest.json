{
  "manifest_version": 3,
  "name": "ChatGPT Rerun",
  "version": "0.3.0",
  "minimum_chrome_version": "116",
  "description": "Resume GitHub-backed ChatGPT work immediately when a Rerun turn finishes, with polling retained as recovery fallback.",
  "permissions": ["storage", "activeTab", "sidePanel", "scripting"],
  "host_permissions": [
    "https://api.github.com/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "ChatGPT Rerun"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content.js", "turn-observer.js"],
      "run_at": "document_idle"
    }
  ]
}
