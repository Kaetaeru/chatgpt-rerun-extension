{
  "manifest_version": 3,
  "name": "ChatGPT Rerun V2",
  "version": "2.0.0",
  "minimum_chrome_version": "116",
  "description": "Keep ChatGPT working toward one repository goal until it is complete, blocked, or needs the user.",
  "permissions": ["storage", "activeTab", "sidePanel", "scripting"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "ChatGPT Rerun V2"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
